# Copy sang .env hoặc dùng với docker compose / Spring.
# KHÔNG commit secret thật vào git.

# PostgreSQL
POSTGRES_DB=quizdb
POSTGRES_USER=quiz
POSTGRES_PASSWORD=quiz
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/quizdb
SPRING_DATASOURCE_USERNAME=quiz
SPRING_DATASOURCE_PASSWORD=quiz

# JWT - PHẢI đổi ở môi trường prod, tối thiểu 32 ký tự.
JWT_SECRET=please-change-me-in-production-this-is-32chars

# Spring
SPRING_PROFILES_ACTIVE=dev

# CORS - danh sách origin frontend được phép gọi API.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
